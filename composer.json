{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.2.5|^8.0",
        "ext-json": "*",
        "anlutro/l4-settings": "^1.0",
        "aspera/xlsx-reader": "^0.8.1",
        "barryvdh/laravel-dompdf": "^0.9.0",
        "beyondcode/laravel-comments": "^1.2",
        "beyondcode/laravel-websockets": "^1.9",
        "diglactic/laravel-breadcrumbs": "^6.0",
        "doctrine/dbal": "^2.5",
        "fideloper/proxy": "^4.4",
        "guzzlehttp/guzzle": "^7.2",
        "laravel-notification-channels/onesignal": "^2.2",
        "laravel/framework": "^6.20",
        "laravel/telescope": "^3.5",
        "laravel/tinker": "^2.5",
        "laravelcollective/html": "^6.2",
        "lasserafn/php-initials": "^3.0",
        "league/csv": "^9.6",
        "league/fractal": "^0.19.2",
        "phpoffice/phpspreadsheet": "^1.18",
        "prettus/l5-repository": "^2.7",
        "sentry/sentry-laravel": "1.5.0",
        "shuchkin/simplexlsxgen": "^1.3",
        "spatie/laravel-activitylog": "^3.16",
        "spatie/laravel-cors": "^1.6",
        "spatie/laravel-fractal": "5.8.0",
        "spatie/laravel-medialibrary": "^7.0.0",
        "spatie/laravel-model-status": "^1.10",
        "spatie/laravel-permission": "^4.2",
        "symfony/property-access": "^5.4"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.5",
        "deployer/deployer": "^6.8",
        "deployer/recipes": "^6.2",
        "edgedesign/phpqa": "^1.23",
        "facade/ignition": "^1.16.4",
        "fakerphp/faker": "^1.9.1",
        "laravel/ui": "^1.0",
        "mockery/mockery": "^1.0",
        "nette/neon": "^3.2",
        "nunomaduro/collision": "^3.0",
        "phpmd/phpmd": "^2.9",
        "phpstan/phpstan": "^0.12.54",
        "phpunit/phpunit": "^8.5.8|^9.3.3",
        "reliese/laravel": "^0.0.18",
        "squizlabs/php_codesniffer": "^3.5",
        "sven/artisan-view": "^3.3"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "7.2.34"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
